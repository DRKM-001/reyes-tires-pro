{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["./**/*.ts", "../lib/site.ts", "../lib/hours.ts", "../lib/api-types.ts", "../lib/quote.ts", "../lib/api-server.ts"]
}
